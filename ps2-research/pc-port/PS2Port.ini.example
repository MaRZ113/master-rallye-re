; PS2Port.ini v2 — only for the PS2-enabled d3d8.dll. Place beside MRRRenderer.ini.
; Paths are relative to this file. Missing or mismatching private assets fall back to Stock.
; Approximation of the PS2 look, not a claim of pixel-exact parity.
[PS2Port]

; --- Reflections ---------------------------------------------------------------
; Reflection: 0 = Stock PC, 4 = PS2 environment reflection + PC framebuffer term (32-bit backbuffer).
Reflection=0
; ReflectionCoverage: 1 = every verified reflective vehicle material, 0 = original pilot subset.
ReflectionCoverage=1
; ReflectionTargetPrecision: 1 = 16-bit reflection target (runtime-accepted), 0 = 32-bit.
ReflectionTargetPrecision=1
; ReflectionDebug: 1 = DIAGNOSTIC env pattern instead of the reflection (top-left red, top-right yellow,
; bottom-left blue, bottom-right cyan). 2 = DIAGNOSTIC view of the real 64x64 env target (4x, top
; centre of the screen). Only for screenshots, keep 0.
ReflectionDebug=0
; ReflectionSourceGXI: PS2 static environment texture.
ReflectionSourceGXI=PS2Grass/PS2EnvSource64x64.gxi

; --- Vehicles ------------------------------------------------------------------
; RaceFleet: 1 = PS2 CAR models for every race car (wheels, crew, lamps, damage continuity), 0 = Stock.
; Single-car races only; races with opponents stay Stock.
RaceFleet=0
; RaceModelAssetDirectory: folder with the *-CAR-FLEET, *-WHEEL-FLEET, *-OFF and content-fix models.
RaceModelAssetDirectory=PS2Vehicles
; BrakeGlow: 1 = PS2 brake lamp ON core + additive glow, 0 = Stock.
BrakeGlow=0
; BrakeGlowAsset: PS2 glow texture.
BrakeGlowAsset=PS2Grass/PS2BrakeGlow.gxi
; FrontendModel: menu/showroom car. 0 = Stock, 2 = PS2 COMPLETE model per car.
FrontendModel=0
; FrontendModelAssetDirectory: folder with the *-COMPLETE-FLEET models.
FrontendModelAssetDirectory=PS2Vehicles
; VehicleLighting: 1 = PS2 vehicle lighting contract on PS2 models (normal-based body shading,
; full environment addition), 0 = previous PC-style full-bright base for A/B.
VehicleLighting=1
; PS2ContentFixes: 1 = fix defects of the original PS2 content (Navara co-driver face,
; cracked right window of Tata CAR, Kamaz CAR and Kamaz menu model). 0 = original PS2 content.
PS2ContentFixes=0

; --- Picture -------------------------------------------------------------------
; PS2Color: 1 = per-channel tone curve on the finished frame, fitted to PC/PS2 screenshot pairs
; (darker mid-tones like the PS2 picture). Approximation, applies to the whole frame incl. HUD. 0 = off.
PS2Color=0
; PS2Output: 1 = PS2 display filter on the finished frame (640x512 -> 512-wide woven fields,
; bilinear, as the PS2 copies its draw buffer to the TV field). Soft picture incl. HUD. 0 = off.
PS2Output=0
; PS2MotionBlur: 1 = PS2 display-copy trail in races (previous frame blended in), 0 = off.
; PS2MotionBlurStrength: PS2 weight of the previous frame per 50 Hz PS2 frame (0..0.9);
; 0.195 = PS2 chase camera (GS dump, FIX 103). Scaled to the PC frame time.
PS2MotionBlur=0
PS2MotionBlurStrength=0.195
; PS2ColorCurve: k for R,G,B in y=(1-k)x+k*x^2 (0 = unchanged, 1 = x^2). Default = fitted values.
PS2ColorCurve=0.426,0.384,0.364

; --- Courses -------------------------------------------------------------------
; Grass / Shrubs: 0 = Stock, 1 = PS2 terrain detail on all verified courses.
Grass=0
Shrubs=0
; GrassAssetDirectory: folder with the *.ps2grass files and Turkey3Puddles.ps2obj.
GrassAssetDirectory=PS2Grass
; GroundDetail: 1 = PS2 ground detail (dark CommonTextures noise subtracted, as on PS2) on ground draws,
; instead of the PC 2x noise multiply. 0 = Stock PC ground.
GroundDetail=0
; GroundDetailAsset: PS2 noise texture.
GroundDetailAsset=PS2Grass/PS2GroundNoise.gxi
; CourseObjects: 1 = extra PS2 puddle surfaces on Turkey3, 0 = Stock.
CourseObjects=0
; Foliage: 1 = PS2 blend contract for the France1 bush, 0 = Stock.
Foliage=0

; --- Diagnostics ---------------------------------------------------------------
; Diagnostics: 1 = feature records in MRRRenderer/logs and F10 race-fleet sidecars.
Diagnostics=0
