+  if(ps2_port_->brake_glow()){lampintegration::repair(*this);ps2_port_->brake_glow()->before_reset();}
+  if(ps2_port_->xtrail()){xtrailintegration::repair(*this);ps2_port_->xtrail()->before_reset();}
+  if(ps2_port_->reflection()){ps2integration::repair(*this);ps2_port_->reflection()->before_reset();}
+  if(ps2_port_->course_objects()){courseintegration::repair(*this);ps2_port_->course_objects()->before_reset();}
+  grassintegration::repair(*this);for(auto* detail:ps2_port_->ground_details())if(detail)detail->before_reset();
+  if(ps2_port_->spline_objects()){splineintegration::repair(*this);ps2_port_->spline_objects()->before_reset();}
+  if(ps2_port_->birds()){birdsintegration::repair(*this);ps2_port_->birds()->before_reset();}
+  if(ps2_port_->collision_debug()){collisionintegration::repair(*this);ps2_port_->collision_debug()->before_reset();}
+  if(ps2_port_->rigid_props()){rigidintegration::repair(*this);ps2_port_->rigid_props()->before_reset();}
+  if(ps2_port_->water()){waterintegration::repair(*this);ps2_port_->water()->before_reset();}
+  ps2_port_->pixel_probe_before_reset();
+  ps2_port_->present_before_reset();
