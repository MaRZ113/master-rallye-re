// Exact retail MRallye.exe only, image base00400000; manual cold-load control.
// No run/call/injection commands. INT3 instrumentation changes timing.
// Each breakpoint disables itself at its decimal hit limit.
bp 0057CE60, "rigid_probe_convex_reader_enter"
SetBreakpointCondition 0057CE60, 0
SetBreakpointFastResume 0057CE60, 0
SetBreakpointSilent 0057CE60, 1
SetBreakpointLog 0057CE60, "RIGID_PROBE event=convex_reader_enter tid={x:tid()} ip={p:eip} ecx={p:ecx} caller={p:[esp]} arg0={p:[esp+4]} hit={u:$breakpointcounter}"
SetBreakpointLogCondition 0057CE60, "$breakpointcounter <= .16"
SetBreakpointCommand 0057CE60, "bpd 0057CE60"
SetBreakpointCommandCondition 0057CE60, "$breakpointcounter == .16"
