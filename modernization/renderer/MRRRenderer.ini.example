; Numeric selectors are canonical; existing text names remain accepted.
; Stock defaults below; stock-plus.ini is the opt-in Classic+ preset.
[Renderer]
ConfigVersion=1

[Display]
; Width/Height set the INITIAL normal CLIENT target; 0/0 adopts the first accepted game/client size.
; A normal drag-resize updates that target only when HWND client and game Reset agree.
; Maximized uses the actual OS CLIENT size; Restore returns to the latest normal target.
; Minimize/zero-size Reset requests never replace the normal target.
; Exclusive validates a display target; 0/0 keeps the first accepted game mode.
; DEVICELOST is forwarded unchanged and recorded with bounded window/device context.
; Borderless 0/0 uses the native monitor size.
; 0 = Stock (default compatibility control)
; 1 = Windowed (supported for interactive development and resizing)
; 2 = Borderless (supported fullscreen-like development mode)
; 3 = ExclusiveFullscreen (experimental; restore after focus loss/minimize is known broken)
Mode=0
Width=0
Height=0
RefreshRate=0
; Managed only in Borderless/ExclusiveFullscreen while foreground/inside.
; 0 = Off
; 1 = On
AutoHideCursor=1
CursorHideDelayMs=1500

[Widescreen]
; Centered4x3 is the stable recommended widescreen mode.
; PreserveMargins v2 is runtime-confirmed; it uses a draw-local WORLD copy.
; Packet coordinates remain untouched; animated margin identity is retained.
; Source45 frontend preview correction is separate from gameplay VFOV.
; 0 = Stock
; 1 = Centered4x3
; 2 = PreserveMargins
InterfaceMode=0

[Filtering]
; 0 = Off
; 1 = On
AnisotropicFiltering=0
MaxAnisotropy=16

[AntiAliasing]
; 0 = Stock
; 1 = MSAA
Mode=0
; Used only when Mode=1. Samples alone does not enable AA.
; Supported color+depth sample count <= request; startup logs show acceptance.
Samples=4

[Camera]
; 0 = Off
; 1 = On
GameplayFOV=0
VerticalFOVDegrees=75.0

[Shadows]
; 0 = Stock
; 1 = Off
Mode=0

[VehicleReflections]
; Locally validated vehicle proof is required.
; 0 = Stock
; 1 = ViewDependent2D
Mode=0

[Compatibility]
; Verified local owner, process-memory only; modified EXEs may be compatible.
; Already-patched owner is reported without a write.
; 0 = Off
; 1 = On
MenuFreezeFix=0

[Trace]
; 0 = Off
; 1 = On
Enabled=1
; 0 = Off
; 1 = On
FrameSummaries=1

[PS2FoliagePilot]
; 0 = Stock; 1 = requested France1Bush01Blend (BLOCKED until live identity proof).
; This diagnostic checkpoint always renders Stock, including Mode=1.
Mode=0
; Opt-in bounded read-only geometry/state probe during an existing F10 capture.
; No rendering override; restart after changing this setting. Trace.Enabled=1 required.
Diagnostics=0
